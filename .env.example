# ============================================================================
# ECS Fleet — environment configuration (copy to .env; .env is git-ignored)
# ============================================================================
# Compose reads this file. ASP.NET Core maps nested keys with "__"
# (e.g. ConnectionStrings__Default, Jwt__SigningKey).

# ---- Runtime ----
# local | Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# ---- PostgreSQL ----
POSTGRES_DB=ecs_fleet
POSTGRES_USER=ecs
POSTGRES_PASSWORD=change_me_strong_password
DB_PORT=5432

# ---- JWT (REQUIRED) ----
# Generate a long random secret (>= 32 chars), e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ISSUER=ECS.Api
JWT_AUDIENCE=ECS.Client

# ---- Ports ----
BACKEND_PORT=5080
FRONTEND_PORT=8080
ADMINER_PORT=8081

# ---- Frontend / CORS ----
# Baked into the SPA at build time. Same-origin via the nginx /api proxy by default.
VITE_API_BASE_URL=/api
FRONTEND_ORIGIN=http://localhost:8080

# ---- Reporting ----
REPORT_COMPANY_NAME=ECS Europe Cargo Service

# ---- Demo data ----
# true ONLY for local/dev/staging — never production.
RUN_DEMO_SEED=false
